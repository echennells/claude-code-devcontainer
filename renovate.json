{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 9am on monday"],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "Group all updates into a single PR",
      "matchPackageNames": ["*"],
      "groupName": "all dependencies",
      "groupSlug": "all"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update ARG versions in Dockerfile from GitHub releases",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>(?!tyrchen/sbe).+?)\\n(?:ENV|ARG) .+?_VERSION=(?<currentValue>.+?)\\n"
      ],
      "extractVersionTemplate": "^v?(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Update SBE_VERSION (tag prefix sbexec-v)",
      "fileMatch": ["(^|/)Dockerfile$"],
      "matchStrings": [
        "# renovate: datasource=github-releases depName=tyrchen/sbe\\nARG SBE_VERSION=(?<currentValue>sbexec-v[^\\n]+)\\n"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "tyrchen/sbe",
      "extractVersionTemplate": "^sbexec-v(?<version>.+)$",
      "versioningTemplate": "semver"
    }
  ]
}
